#!/usr/bin/env bash
# ~/.config/nvim/scripts/sandbox-run
# ----------------------------------------------------------------
# 用 bubblewrap 给代码执行套个最小化沙盒：
#   - 系统目录 /usr /lib /bin /etc /opt 只读
#   - $HOME/.venv / .cargo / .npm 等只读复用
#   - 当前工作目录 可读可写（代码得能产出文件）
#   - 默认 --unshare-net 断网（防恶意代码外联）
#   - /tmp 用 tmpfs（隔离临时文件）
#
# 临时关沙盒：命令前加 SANDBOX=0
# 想保留网络（pip install 等）：加 SANDBOX_NET=1
#
# 用法：sandbox-run <command> [args...]
# 例：
#   sandbox-run python3 -u script.py
#   SANDBOX=0 sandbox-run pip install requests
#   SANDBOX_NET=1 sandbox-run python3 -u scraper.py
# ----------------------------------------------------------------

set -uo pipefail
# 注意：不用 set -e，否则 add_ro 里的 [[ -e ]] 失败会退出

# 沙盒总开关：SANDBOX=0 跳过
if [[ "${SANDBOX:-1}" == "0" ]]; then
    exec "$@"
fi

if ! command -v bwrap > /dev/null 2>&1; then
    echo "[sandbox-run] bwrap 未安装，回退到直接执行" >&2
    exec "$@"
fi

# 收集需要 bind 的路径（只把存在的目录加进来）
ARGS=()
add_ro() {
    [[ -e "$1" ]] && ARGS+=("--ro-bind" "$1" "$1") || true
}

# 系统目录（只读）
add_ro /usr
add_ro /lib
add_ro /lib64
add_ro /bin
add_ro /sbin
add_ro /etc
add_ro /opt
add_ro /nix

# 家目录下的工具链目录（只读复用：venv / rustup / npm 等运行时无需写）
# （.cargo 不在这里 —— 见下方可写组，cargo 下载依赖要写 registry）
for sub in ".venv" ".rustup" ".npm" ".deno"; do
    [[ -d "$HOME/$sub" ]] && ARGS+=("--ro-bind" "$HOME/$sub" "$HOME/$sub") || true
done

# 工具链缓存目录必须可写：只读会让工具退回 tmpfs、每次重编译/重下载。
#   Go   —— GOCACHE 编译缓存 + GOMODCACHE 模块缓存（GOPATH 默认 ~/go；
#           旧脚本写的 .local/share/go 是死路径）
#   Rust —— CARGO_HOME 下的 registry 索引/缓存，cargo 拉依赖要写
for sub in "go" ".cache/go-build" ".cargo"; do
    [[ -d "$HOME/$sub" ]] && ARGS+=("--bind" "$HOME/$sub" "$HOME/$sub") || true
done

# 必需的虚拟文件系统
ARGS+=("--dev" "/dev")
ARGS+=("--proc" "/proc")
ARGS+=("--tmpfs" "/tmp")

# 当前工作目录可读写
CWD="$(pwd)"
ARGS+=("--bind" "$CWD" "$CWD")

# HOME 指向 cwd（避免代码往真实 $HOME 写东西）
ARGS+=("--setenv" "HOME" "$CWD")
ARGS+=("--setenv" "SANDBOX" "1")

# 网络开关：默认断网，SANDBOX_NET=1 才放开
if [[ "${SANDBOX_NET:-0}" != "1" ]]; then
    ARGS+=("--unshare-net")
fi

# 会话隔离 + 父进程退出时一并杀掉
ARGS+=("--new-session" "--die-with-parent")

exec bwrap "${ARGS[@]}" "$@"
